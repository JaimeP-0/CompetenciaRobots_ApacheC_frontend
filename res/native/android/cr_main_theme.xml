<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema tras el splash: sin edge-to-edge forzado (API 35) y barra alineada al fondo de la app. -->
    <style name="Theme.CR.Main" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">#f5f7fb</item>
        <item name="android:navigationBarColor">#f5f7fb</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
